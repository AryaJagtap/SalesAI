# SalesAI V2.0 — Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (Primary AI Engine)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (Secondary / Fallback AI Engine)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# CORS Origins (comma-separated, for production deployment)
# Example: https://salesai-v2.vercel.app
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
